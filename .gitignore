# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# --- Agent state (regenerated per session; never committed) -------------------
.outline/
.serena/
.goals/
.claude/
.tokensave/
.ignore

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# --- Local state and secrets --------------------------------------------------
# Real credentials go on the RunPod endpoint template. `.env.example` is
# committed; `.env` never is.
.env
.env.*
!.env.example

# Agent/tooling credential files that live in the working tree. Named
# explicitly rather than by a broad pattern, so the list stays auditable —
# a `git add -A` must never be able to stage a live key.
.runpod_key
*_api_key
*_token
credentials.json

# Agent workspace — lives on disk, deliberately not published to GitHub.
# AGENTS.md and CLAUDE.md are also regenerated by the outline SessionStart hook,
# so a clone would get stale copies of files that are rewritten every session.
# These are regenerable or workspace-local; the product is worker/ + README.
AGENTS.md
CLAUDE.md
IDENTITY.md
RESEARCH-NOTES.md
worker/AGENTS.md

# Editor-only type-checker config. Its one CI consumer is marked
# `continue-on-error: true`, so nothing breaks without it. Kept on disk for
# editors that resolve the flat-module layout via `extraPaths`.
pyrightconfig.json

# Editor/tool state
.mcp.json
*.log
