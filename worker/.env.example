# Environment for the YuE2 serverless worker — copy to .env for local runs.
#
# Set these on the RunPod endpoint template in production, never in the image.
# A key baked into a Dockerfile persists in the image layers forever.

# --- Model cache (the network volume) ----------------------------------------
# Mount point of the RunPod network volume. Weights are cached here and are
# never baked into the image.
VOLUME_ROOT=/runpod-volume

# Set true once the volume is warm, to make a missing blob fail loudly instead
# of silently re-downloading. Leave false (or unset) for the first cold start.
HF_LOCAL_FILES_ONLY=false

# Only needed if the model repos ever become gated. Not required today —
# both m-a-p/YuE2-3B and m-a-p/YuE2-Vae are public.
# HF_TOKEN=

# --- Artifact egress: Backblaze B2 (S3-compatible) ---------------------------
# All four are required. The key needs writeFiles on the bucket; it never needs
# listBuckets, because nothing in storage.py enumerates the bucket.
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-west-004

# Presigned GET lifetime, seconds. Default 7 days.
B2_URL_TTL_SECONDS=604800

# --- Worker behaviour --------------------------------------------------------
# Wall-clock budget for one job. A full-CoT 3.6-minute song measures ~71 s of
# generation on a 4090; 1800 s leaves headroom for longer songs and slow boots.
JOB_TIMEOUT_SECONDS=1800

# The pipeline's own English progress spinner writes to stderr. Off by default;
# turn on for interactive debugging, leave off for serverless logs.
YUE2_PROGRESS=false

# Which VAE decoder to report in the response. `m-a-p/YuE2-Vae-legacy` exists
# only to reproduce the published benchmark protocol — it is not the default.
YUE2_VAE=m-a-p/YuE2-Vae

# Default chain-of-thought mode when a job does not specify one.
DEFAULT_COT=full

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
